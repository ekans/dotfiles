include "/etc/niri/config.kdl"

// Caps Lock is a second Enter. The layout is restated from `localectl`
// because setting any xkb field stops niri reading it from there.
input {
    keyboard {
        xkb {
            layout "fr"
            variant "afnor"
            model "microsoftpro"
            options "terminate:ctrl_alt_bksp,caps:return"
        }
    }
}

// I never stack windows in a column, so vertical keys switch workspaces.
binds {
    Mod+Up        { focus-workspace-up; }
    Mod+Down      { focus-workspace-down; }
    Mod+K         { focus-workspace-up; }
    Mod+J         { focus-workspace-down; }
    Mod+Ctrl+Up   { move-column-to-workspace-up; }
    Mod+Ctrl+Down { move-column-to-workspace-down; }
    Mod+Ctrl+K    { move-column-to-workspace-up; }
    Mod+Ctrl+J    { move-column-to-workspace-down; }

    // The lock screen is ~/.config/quickshell/chauvenity-lock (lock.sh starts
    // it), in place of /etc/niri/config.kdl's swaylock. allow-when-locked as
    // there: a lock that died can be replaced from the keyboard, and pressed
    // while the lock is up it only waits for it.
    Mod+Alt+L allow-when-locked=true hotkey-overlay-title="Lock the Screen" { spawn "/var/home/ducatore/.config/quickshell/chauvenity-lock/lock.sh"; }

    // The laptop's own panel off and on, unlike Mod+Shift+P's
    // power-off-monitors: it stays off when a key is pressed, and its
    // windows move to the other monitors. niri reports an off output with
    // no current mode.
    F1 allow-when-locked=true hotkey-overlay-title="Turn the laptop screen off or on" { spawn-sh r#"niri msg output eDP-1 "$(niri msg -j outputs | jq -r '.["eDP-1"].current_mode | if . == null then "on" else "off" end')""#; }

    // One key to every plugin, then a key at a time, the way Spacemacs does
    // it: b bb, v clipboard, s snippets, t translate, n notifications,
    // c caffeine, w the walkpad, o a bar panel, h the bar's hints, ? the
    // shortcuts. Typed without a pause, nothing shows; after one, a strip
    // with the next keys. Lives in ~/.config/quickshell/chauvenity
    // (Leader.qml, the keys in leader-menu.mjs).
    Mod+Space hotkey-overlay-title="Leader menu" { spawn "/usr/bin/qs" "-c" "chauvenity" "ipc" "call" "leader" "toggle"; }
}

// The wallpaper is the bar's own (~/.config/quickshell/chauvenity,
// Wallpaper.qml), on the background layer. In the backdrop it stays still
// while workspaces slide and shows in the overview; the workspace background
// is transparent so it does not paint over it.
layer-rule {
    match namespace="^wallpaper$"
    place-within-backdrop true
}
layout {
    background-color "transparent"
}

// The overlays (keys, translate, bb-go, bb-new, clipboard, snippets) blur what
// is behind them. niri's default "xray" blur shows only the wallpaper, so a
// card would look the same over any window.
layer-rule {
    match layer="overlay"
    background-effect {
        xray false
    }
}
