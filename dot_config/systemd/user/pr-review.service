# The pull requests waiting for your review in the niri session: serves the
# Super+Space p overlay. Config in ~/.config/quickshell/pr-review/. Repos to
# leave out are `gh search` qualifiers in ~/.config/pr-review/search, which is
# not in this repo.
[Unit]
Description=Pull request review overlay (niri session)
# Same lifetime as the chauvenity-* units: see
# /usr/lib/systemd/user/niri.service.d/10-chauvenity-session.conf
BindsTo=niri.service
After=niri.service graphical-session.target

[Service]
Type=exec
# gh is in /usr/bin or ~/.local/bin, bat in linuxbrew, bb in ~/.npm-global/bin
# and runs on node from mise, none of which the user manager's PATH includes:
# bb.service's PATH, with bb in front.
Environment=PATH=%h/.npm-global/bin:%h/.local/share/mise/shims:/home/linuxbrew/.linuxbrew/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/qs -c pr-review
Restart=on-failure
RestartSec=1
Slice=session.slice
