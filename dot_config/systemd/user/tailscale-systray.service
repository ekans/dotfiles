# Tailscale's tray icon. GNOME shows it through bluefin's AppIndicator
# extension.
#
# Upstream's unit (`tailscale configure systray --enable-startup=systemd`) is
# WantedBy=default.target, so it also runs with no graphical session at all.
# graphical-session.target is reached by every graphical login, GNOME and niri
# alike, and stopped at logout. Enabled by the symlink chezmoi manages in
# graphical-session.target.wants/, since chezmoi never runs systemctl.
[Unit]
Description=Tailscale tray icon
Documentation=https://tailscale.com/kb/1597/linux-systray
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=exec
ExecStart=/usr/bin/tailscale systray
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
